VITE_LNET_RPC_URL=http://34.69.184.205:4545
VITE_LNET_CHAIN_ID=648540
VITE_BUNDLER_URL=https://bundler.l-net.io
VITE_READ_RPC_URL=https://bundler.l-net.io
VITE_ENTRYPOINT_ADDRESS=0x9fD181236dA8c890bD5007b44B80E395E130c57D
VITE_FACTORY_ADDRESS=0x5589A0E344688976e473FD56BAe94411d9d56f67

# ERC-721 Pixel Flores. Se llena con lo que imprime scripts/deploy-nft.cjs.
VITE_NFT_ADDRESS=

# Carpetas IPFS de la colección (CIDs ya verificados, no cambian).
VITE_IMAGES_CID=bafybeiepelrkkegnony6zrgjbqzkxenb2ixqdzbipqrytbpbkize54s72q
VITE_METADATA_CID=bafybeigqyo3ljar4nxmzmlfi5vca5fuje4t4dbdoro2c3jfelkmg74n7oy
VITE_IPFS_GATEWAY=https://ipfs.io

# --- Backend /api (sin VITE_: nunca llegan al browser) ---
KEYCLOAK_URL=https://auth.l-net.io
KEYCLOAK_REALM=naas-realm
KEYCLOAK_CLIENT_ID=naas-client
KEYCLOAK_CLIENT_SECRET=
NAAS_USERNAME=
NAAS_PASSWORD=
BUNDLER_URL=https://bundler.l-net.io
SESSION_SECRET=

# Policy de escritura. IMPORTANTE: el default de ALLOWED_INNER_CALLS es
# set(uint256) (del ejemplo Storage), así que sin esta línea el proxy rechaza
# todos los minteos con "inner call 0x1249c58b is not allowed".
# Default seguro: solo mint() sobre el contrato del NFT. Con `*` la policy acepta
# un UserOp contra cualquier contrato.
ALLOWED_CALL_TARGETS=0xcAfAf19c68E4E6c90E3fBdc7Df15d21B83AE6D9C
ALLOWED_INNER_CALLS=mint()

# --- Deploy del contrato (solo para scripts/deploy-nft.cjs) ---
# LNET es permisionada: hacen falta las dos claves que habilita el equipo de LNet.
#   RELAYER_PK = caller en allowlist del Hub (manda el tx)
#   SENDER_PK  = deployer permisionado (firma el Forward EIP-712)
RELAYER_PK=
SENDER_PK=
HUB_ADDRESS=0x4053cA6bcdEc6638d9Ad83a5c74d0246C7670ACd
VITE_EXPLORER_URL=https://explorer-testnet.l-net.io
